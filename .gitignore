# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
snippets.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only tools (depend on a local CLI like yt-dlp; can't run in the deployed
# serverless environment, so they're kept off GitHub and never ship. The page and
# api dirs must stay under src/app for Next.js routing, so each path is ignored
# individually rather than as one shared folder.)
/src/app/tools/youtube-comments-analyzer/
/src/app/api/tools/youtube-comments-analyzer/
/src/lib/youtube-comments/
